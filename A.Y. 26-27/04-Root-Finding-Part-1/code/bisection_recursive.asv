% Clear workspace, figures, and command window for a fresh start
clear variables  % Removes all variables from workspace
close all  % Closes all figure windows
clc        % Clears command window
f = @(x) x.^2 - 2;  % Find sqrt(2)
a = 0;              % Left endpoint
b = 2;              % Right endpoint
tol = 1e-6;         % Tolerance

% Recursion is a specific way to code in which the function calls itself
% iteratively for a non-defined number of times.
% You need to define what the base cases are, then call it externally.
% In many cases, you lose track of the number of calls and of what is 
% going on! It is (sometimes) useful, but BE CAREFUL!
% Example: the Fibonacci sequence.
% Base cases Fib(1) = 1; Fib(2) = 1;
% Fib(n) = Fib(n-1) + Fib(n-2)
% If Fib(10) is called, it's going to call on Fib(8) and Fib(9), which
% rely on Fib(6), Fib(7), etc...
% The only case in which it is ACTUALLY used is the sort() function
% with ana 


% Run
root = BisectionRecursive(f, a, b, tol);
fprintf('Root found at x = %.6f\n',root);

%% Function definition
function c = BisectionRecursive(funz, a, b, tol)
    % Alternative example of Bisection implementation
    % using recursive approach.

    %
    % Inputs:
    %   funz - Function handle
    %   a, b - Interval endpoints
    %   eps  - Tolerance for convergence

    fa = funz(a);
    fb = funz(b);

    if fa == 0
        c = a;
        return
    elseif fb == 0
        c = b;
        return
    end
    
    % Check Bolzano theorem condition
    if sign(fa)*sign(fb) < 0
        c = a + (b-a)/2;    % c is always evaluated
        if (abs(b-a)<=tol)  % If tolerance is reached, we stop
            return
        else                % If tolerance is not reached, we go on
            fc = funz(c);

            if sign(fc)*sign(fb) <= 0
                a = c;
            else
                b = c;
            end
            c = BisectionRecursive(funz,a,b,tol);
        end
    else
        fprintf("Bolzano theorem is not satisfied!")
    end
end